# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=sk-...                 # https://platform.openai.com/api-keys
LLM_BACKEND=openai                    # "openai" (default, fast) or "local" (Gemma 4 via llama.cpp, see README)
OPENAI_MODEL=gpt-4.1
STT_BACKEND=openai                    # "openai" (default) or "parakeet" (fully local, ~650MB download)

# Monad testnet (chain 10143). Use a THROWAWAY wallet funded from https://faucet.monad.xyz
MONAD_RPC=https://rpc.ankr.com/monad_testnet   # more reliable than the default public RPC; others are tried automatically on failure
MONAD_CHAIN_ID=10143
WALLET_PRIVATE_KEY=0x...
STT_MODEL=gpt-4o-transcribe          # higher-accuracy speech model (gpt-4o-mini-transcribe is a cheaper fallback)
